# =================================================================
# Antigravity Data Extraction Microservice - Environment Configuration
# =================================================================

# 1. LLM Provider ("groq" or "openai")
LLM_PROVIDER=groq

# 2. Groq Configuration (Free tier from https://console.groq.com)
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# 3. Optional OpenAI Configuration (if using OpenAI or other OpenAI-compatible provider)
# OPENAI_API_KEY=sk-your-openai-api-key
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# 4. Guardrails & Limits
MAX_INPUT_CHARACTERS=40000
MIN_INPUT_CHARACTERS=10
MAX_RETRIES=2
REQUEST_TIMEOUT_SECONDS=30.0

# 5. Testing & Offline Mock Mode
# If True, generates synthetic structured data when no API key is set, enabling instant out-of-the-box local testing
ALLOW_MOCK_FALLBACK=True

# 6. Server Settings
HOST=0.0.0.0
PORT=8000
